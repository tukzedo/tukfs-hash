#!/usr/bin/env bash

#  shellcheck disable=2053  ## 'Quote the right-hand side of == in [[ ]].' fIsDoc's glob match is meant.

##	- Purpose: Run the merge gate, cicd.bash --merge-gate, before a push moves
##	  main, since dev into main is a release. A push of dev or any other
##	  branch goes straight through.
##	- A push that changes only docs, the globs in cicd/docs-paths, isn't
##	  gated either. That's judged against what the remote's main has, so a
##	  new or unknown remote commit runs the gate. No docs-paths file means
##	  nothing counts as docs.
##	- The gate runs on the commit being pushed, not on the working tree: an
##	  uncommitted fix mustn't pass a broken commit, and an uncommitted breakage
##	  mustn't block a good one. cicd.bash checks it out into its frozen copy,
##	  in the run's guarded temp dir, and builds into target-gate.
##	- A commit whose tree a run already passed goes out without the gate
##	  running again, since cicd.bash records each tree a run at least as
##	  thorough as the merge gate passes (utility/green-tree.bash).
##	  TUKFS_GATE_RERUN=1 runs it anyway.
##	- A commit with no cicd/cicd.bash in it, from before the pipeline, isn't
##	  gated.
##	- Escape hatch: `git push --no-verify`, or TUKFS_SKIP_HOOK=1.
##	- Turned on per clone by pointing git at this directory:
##		git config core.hooksPath cicd/hooks
##	- git opens the ssh session before this runs and sends after it returns.
##	  The gate takes most of an hour, which can outlast an idle session, and
##	  the push then dies with exit 141 after a green gate. ssh's
##	  ServerAliveInterval keeps it up.
##	History: At bottom of script.

##	Copyright © 2026 t00mietum (CryptogID: ปʬϝღถɔ4რఠΔթะ9ƾǝu)
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT

set -Eeuo pipefail

[[ -n "${TUKFS_SKIP_HOOK:-}" ]] && exit 0

## A push from a linked worktree hands the hook GIT_DIR and friends, which
## would point every git call the gate makes at the wrong place.
for gitVar in $(git rev-parse --local-env-vars 2>/dev/null || true); do unset "${gitVar}"; done

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/../.." && pwd)"

## The globs, with blank and ## lines dropped.
docGlobs=()
if [[ -f "${root}/cicd/docs-paths" ]]; then
	while IFS= read -r line || [[ -n "${line}" ]]; do
		[[ -z "${line}" || "${line}" == '#'* ]] || docGlobs+=("${line}")
	done < "${root}/cicd/docs-paths"
fi
fIsDoc(){ local g; for g in "${docGlobs[@]}"; do [[ "$1" == ${g} ]] && return 0; done; return 1; }

## True when every file that differs between the 2 commits is a doc. A
## missing commit, or none at all, reads as code, and so does a failed diff,
## which hands back a name that isn't a doc.
fDocsOnly(){   ## fDocsOnly OLD_SHA NEW_SHA
	local f="" any=0
	[[ "$1" =~ ^0+$ ]] && return 1
	git -C "${root}" cat-file -e "$1^{commit}" 2>/dev/null || return 1
	while IFS= read -r -d '' f; do
		any=1
		fIsDoc "${f}" || return 1
	done < <(git -C "${root}" diff -z --no-renames --name-only "$1" "$2" || echo -n $'\x01\0')
	((any))
}

## stdin gives "<local ref> <local sha> <remote ref> <remote sha>" per ref. All
## zeros is a delete, with nothing to test. Collected inside the loop, since the
## read that ends it clears the vars.
gatedShas=(); gatedRefs=()
while read -r _localRef localSha remoteRef remoteSha; do
	case "${remoteRef}" in
		refs/heads/main)
			[[ "${localSha}" =~ ^0+$ ]] && continue
			if fDocsOnly "${remoteSha}" "${localSha}"; then
				echo
				echo "[ pre-push: ${localSha:0:12} changes only docs, so the gate isn't run ]"
				echo
				continue
			fi
			refName="${remoteRef#refs/heads/}"; seen=0
			for i in "${!gatedShas[@]}"; do
				[[ "${gatedShas[i]}" == "${localSha}" ]] || continue
				gatedRefs[i]="${gatedRefs[i]} + ${refName}"; seen=1
			done
			((seen)) || { gatedShas+=("${localSha}"); gatedRefs+=("${refName}"); } ;;
	esac
done
((${#gatedShas[@]})) || exit 0

for i in "${!gatedShas[@]}"; do
	sha="${gatedShas[i]}"
	if ! git -C "${root}" cat-file -e "${sha}:cicd/cicd.bash" 2>/dev/null; then
		echo
		echo "[ pre-push: ${sha:0:12} has no cicd/cicd.bash, so there's no gate to run on it ]"
		echo
		continue
	fi
	## A failed lookup reads as not passed.
	tree="$(git -C "${root}" rev-parse -q --verify "${sha}^{tree}" || true)"
	if [[ -n "${tree}" && -z "${TUKFS_GATE_RERUN:-}" ]] && "${root}/cicd/utility/green-tree.bash" passed "${root}" "${tree}"; then
		echo
		echo "[ pre-push: ${sha:0:12} has the same files as a run that passed the gate; not running it again ]"
		echo
		continue
	fi
	echo
	echo "[ pre-push: running the merge gate on ${sha:0:12} before ${gatedRefs[i]} ]"
	echo
	if ! TUKFS_GATE_REV="${sha}" "${root}/cicd/cicd.bash" --merge-gate; then
		echo
		echo "[ pre-push: the gate failed on ${sha:0:12}, so the push is refused (--no-verify overrides) ]" >&2
		echo
		exit 1
	fi
done
exit 0


##	History:
##		- 2026-10-23: Created from shcl's pre-push hook. It gates dev and main, and
##		  cicd.bash makes the worktree for the pushed commit.
##		- 2026-10-23: main isn't gated, and neither is a docs-only push.
##		- 2026-10-25: --merge-gate on main only, dev not gated, and the docs
##		  globs from cicd/docs-paths.
