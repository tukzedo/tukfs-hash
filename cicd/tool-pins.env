# shellcheck shell=bash
# shellcheck disable=SC2034  ## read by config.bash, which this is sourced from

##	Purpose:
##		- Versions of the tools the pipeline was last checked with. cicd.bash
##		  warns when the box has something else, so a lint result that moved can
##		  be traced to the tool rather than the code.
##		- The stable Rust toolchain is pinned in rust-toolchain.toml, since rustup
##		  reads it from there. Bump any pin on purpose: change it, run the full
##		  pipeline, commit.
##	History: At bottom of file.

##	Copyright © 2026 t00mietum (CryptogID: ปʬϝღถɔ4რఠΔթะ9ƾǝu)
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT


PIN_SHELLCHECK="0.11.0"
## markdownlint-cli, the `markdownlint` command, not markdownlint-cli2.
PIN_MARKDOWNLINT="0.49.1"
## Sanitizers and Miri need -Z flags, so they run on this dated nightly. The
## leak check image is built with it too.
PIN_NIGHTLY="nightly-2026-10-16"
## The leak check image's CodeQL bundle, by its sha256. Findings move between
## releases.
PIN_CODEQL="2.27.2"
PIN_CODEQL_SHA256="f002864be6dd8d5d7bdb123aaf7291ec8e291012bd9f70b6d2362f730db52aeb"
## Known advisories. Runs on the host, since it fetches the advisory db.
PIN_CARGO_DENY="0.19.9"
## The arm64 release build. zig compiles the bundled SQLite and links, so a
## new zig can change the bytes.
PIN_CARGO_ZIGBUILD="0.23.0"
PIN_ZIG="0.16.0"
## The .deb and .rpm. A go-installed nfpm says "dev" to --version, so the
## version is read off the module it was built from.
PIN_NFPM="v2.43.0"
## Lints the dogfood runner. Its rules move between releases.
PIN_PSSA="1.25.0"


##	History:
##		- 2026-10-23: Created.
##		- 2026-10-23: cargo-zigbuild, zig, nfpm and PSScriptAnalyzer.
##		- 2026-10-23: CodeQL and cargo-deny, for the leak checks.
